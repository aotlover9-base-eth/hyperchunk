<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperChunk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HyperChunk"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dynamic Launcher Icon: Rose Crimson (Default) -->
        <activity-alias
            android:name=".MainActivityRoseCrimson"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose_crimson"
            android:roundIcon="@mipmap/ic_launcher_rose_crimson"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon: Pixel Blue -->
        <activity-alias
            android:name=".MainActivityPixelBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pixel_blue"
            android:roundIcon="@mipmap/ic_launcher_pixel_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon: Cyber Cyan -->
        <activity-alias
            android:name=".MainActivityCyberCyan"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyber_cyan"
            android:roundIcon="@mipmap/ic_launcher_cyber_cyan"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon: Electric Lime -->
        <activity-alias
            android:name=".MainActivityElectricLime"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_electric_lime"
            android:roundIcon="@mipmap/ic_launcher_electric_lime"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon: Amethyst Violet -->
        <activity-alias
            android:name=".MainActivityAmethystViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amethyst_violet"
            android:roundIcon="@mipmap/ic_launcher_amethyst_violet"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon: Sunset Amber -->
        <activity-alias
            android:name=".MainActivitySunsetAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset_amber"
            android:roundIcon="@mipmap/ic_launcher_sunset_amber"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon: Monochrome -->
        <activity-alias
            android:name=".MainActivityMonochrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:roundIcon="@mipmap/ic_launcher_monochrome"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alarm & Reminder Broadcast Receiver -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="true" />

        <!-- Reschedule Alarms after Device Reboot -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- HyperOS 3 Native Homescreen Widget -->
        <receiver
            android:name=".widget.HyperChunkWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hyperchunk.app.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>

</manifest>
