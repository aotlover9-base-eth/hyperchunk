<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_hyperos">

    <!-- 24-Hour Color Edge Ring Canvas -->
    <ImageView
        android:id="@+id/widget_edge_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="24h Color Edge Ring" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:orientation="vertical">

        <!-- Header bar -->
        <RelativeLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_widget_dot"
                android:contentDescription="Icon" />

            <TextView
                android:id="@+id/widget_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="7dp"
                android:layout_toEndOf="@id/widget_icon"
                android:text="HYPERCHUNK"
                android:textColor="#00F2FE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Status Pill -->
            <TextView
                android:id="@+id/widget_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_pill_bg"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="NOW ACTIVE"
                android:textColor="#A8FF78"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Active Task Title -->
        <TextView
            android:id="@+id/widget_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="College Lecture 1"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Time slot & remaining time -->
        <LinearLayout
            android:id="@+id/widget_time_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_task_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:30 – 10:00"
                android:textColor="#9EABB9"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#5A6472"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_time_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45m left"
                android:textColor="#00F2FE"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <!-- Up Next task banner -->
        <TextView
            android:id="@+id/widget_next_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Next: Study &amp; Revision (10:00)"
            android:textColor="#8A96A8"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
